# Tash Bags unified backend environment
# --- Postgres (docker compose spins up the defaults below) ---
DATABASE_URL=postgres://tashbags:tashbags@localhost:5432/tashbags

# --- Shopify storefront (no auth needed for products/collections) ---
SHOPIFY_STOREFRONT_URL=https://tashbags.com

# --- Shopify Admin API (optional: enables orders + customer sync) ---
# Create a private app / admin API token at admin.shopify.com > Settings > Apps and channels > Develop apps
SHOPIFY_ADMIN_API_VERSION=2026-01
# SHOPIFY_ADMIN_TOKEN=
# SHOPIFY_MYSHOPIFY_DOMAIN=tashbags.myshopify.com

# --- Myntra / other D2C marketplace adapters ---
# Adapters accept CSV/JSON imports (see src/channels/) until API creds are provided.
# MYNTRA_API_KEY=
# MYNTRA_EMAIL=

# --- ShipRocket (shipping + COD reconciliation) ---
# SHIPROCKET_EMAIL=
# SHIPROCKET_PASSWORD=

# --- WhatsApp AI agent (WAHA / whatsmeow bridge) ---
# Point at the WAHA instance (runs here on :3000; the laptop is the bridge host)
WAHA_API_URL=http://localhost:3000
# WAHA_API_KEY=            # X-Api-Key for WAHA Plus, if enabled
WAHA_SESSION=default
AGENT_OWNER_PHONES=       # comma-separated WhatsApp numbers treated as owner
# Speak new owner alerts through the laptop speakers via the local aurora assistant
AGENT_LAPTOP_ALERT=false
# Semicolon-separated business facts the agent uses to answer ("HSN 4202;GST 18%")
AGENT_BUSINESS_FACTS=

# --- Server ---
PORT=4000
HOST=0.0.0.0
# Cron schedule for automatic resync (UTC). Empty string disables.
SYNC_CRON=0 */4 * * *